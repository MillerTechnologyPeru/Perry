left_analog_up = w
left_analog_down = s
left_analog_left = a
left_analog_right = d
right_analog_up = mouse_movement_up
right_analog_down = mouse_movement_down
right_analog_left = mouse_movement_left
right_analog_right = mouse_movement_right
# The right stick's speed as the mouse: gptokeyb divides the stick by this
# each 16 ms (512 by default, too fast to aim with).
mouse_scale = 1536
r2 = mouse_left
l2 = mouse_right
a = space
b = f
x = r
y = tab
l1 = e
r1 = g
l3 = leftctrl
r3 = z
up = up
down = down
left = q
right = right
back = esc
start = numpadenter
