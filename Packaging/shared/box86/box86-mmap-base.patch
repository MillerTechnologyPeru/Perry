diff --git a/src/custommem.c b/src/custommem.c
index a8cdfd1..474e0b1 100644
--- a/src/custommem.c
+++ b/src/custommem.c
@@ -1087,9 +1087,13 @@ void* findBlockNearHint(void* hint, size_t size, uintptr_t mask)
 {   void* ret = findBlockHinted(hint, size, mask);
     return ret?ret:hint;
 }
+// Where mappings with no address asked start from: MEDIAN, or what
+// BOX86_MMAP_BASE gives, for a program that maps a block of its own at a
+// fixed address that these would otherwise be in the way of.
+uintptr_t box86_mmap_base = 0;
 void* find32bitBlock(size_t size)
 {
-    void* ret = findBlockHinted(MEDIAN, size, 0);
+    void* ret = findBlockHinted(box86_mmap_base?(void*)box86_mmap_base:MEDIAN, size, 0);
     if(!ret) ret = findBlockHinted(LOWEST, size, 0);
     return ret;
 }
