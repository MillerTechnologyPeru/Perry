// Every PERRY_* environment variable Perry reads, one a line:
//
//   PERRY_SETTING(NAME, kind, "Group", help, "what it does")
//
// NAME is the variable without its PERRY_ prefix. The kind says how its
// value is read:
//
//   flag     set or unset; the value is ignored
//   bool01   set and not "0" is on
//   number   an integer or a decimal, with a default when unset
//   string   text, or one of the values the summary names
//   path     a file or directory
//   list     items separated as the summary says
//   dynamic  set by Perry itself, and read again on each use
//
// "help" lines are the ones `perry --help` lists; `perry --settings` lists
// them all, by group. A variable a provider reads by name must be here:
// Tests/PerryLoaderTests/SettingsTests.swift checks Sources against it.
//
// Include it with PERRY_SETTING defined (perry_settings.h does).

// MARK: Loader
PERRY_SETTING(TRACE, list, "Loader", help, "comma-separated: load, bind, init, all")
PERRY_SETTING(PROFILE, path, "Loader", help, "sample the main thread's stacks into this file (Scripts/perry-profile.py reports them)")
PERRY_SETTING(PROFILE_HZ, number, "Loader", help, "samples a second of CPU time, 250 by default")
PERRY_SETTING(PROFILE_ALL, bool01, "Loader", detail, "sample whichever thread runs, on the process's CPU clock, not only the main thread")
PERRY_SETTING(CRASH_REPORT, bool01, "Loader", help, "on a fatal signal, print registers and frames")
PERRY_SETTING(UNIMPLEMENTED, string, "Loader", help, "continue: an unresolved function reports itself once and returns 0 instead of aborting")
PERRY_SETTING(LIBRARY_PATH, list, "Loader", help, "colon-separated directories with provider libraries")
PERRY_SETTING(SWIFT_RUNTIME, path, "Loader", detail, "directory of Darwin's Swift runtime and overlays, such as the iOS Simulator's")
PERRY_SETTING(SWIFT_TYPE_TRACE, flag, "Loader", detail, "report Swift type names the runtime can't make a type of")
PERRY_SETTING(METAL, bool01, "Loader", detail, "0: no Metal device even with libPerryMetal there, so apps fall back to OpenGL ES")
PERRY_SETTING(REEXECUTED, dynamic, "Loader", detail, "set by perry when it runs itself again to map low memory")
PERRY_SETTING(GDB, string, "Loader", detail, "native: don't answer a debugger's GDB/MI session as gdb")
PERRY_SETTING(GDB_LOG, path, "Loader", detail, "append the GDB/MI conversation to this file")

